{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "profile_version",
    "sources",
    "claims"
  ],
  "properties": {
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "path",
          "availability",
          "version"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "provided",
              "missing"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "kind",
          "text",
          "evidence",
          "limitations"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "reported",
              "observed",
              "inference",
              "proposal",
              "unknown"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
